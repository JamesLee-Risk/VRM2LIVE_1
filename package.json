{
  "name": "vrm2live",
  "version": "0.2.1",
  "description": "VRM 虛擬形象直播軟體（簡易版）",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "test:dsp": "node scripts/test-dsp.mjs",
    "make-anims": "node scripts/make-test-animations.mjs",
    "test:hotkeys": "node scripts/test-hotkeys.mjs",
    "test:body": "node scripts/test-body.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "node scripts/build.mjs && electron-builder --win nsis",
    "test": "node scripts/test-dsp.mjs && node scripts/test-hotkeys.mjs && node scripts/test-body.mjs"
  },
  "build": {
    "appId": "com.vrm2live.studio",
    "productName": "VRM2LIVE",
    "directories": {
      "buildResources": "packaging",
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "build/**/*",
      "package.json",
      "!build/.test*",
      "!**/*.map",
      "!**/*.vrm",
      "!node_modules/three/**",
      "!node_modules/@pixiv/**",
      "!node_modules/@mediapipe/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "packaging/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VRM2LIVE",
      "artifactName": "VRM2LIVE-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22",
    "@pixiv/three-vrm": "^3.4.4",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.11"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.25.12": true
  }
}
